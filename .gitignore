# Academy 辩论教练 · 开发目录 .gitignore
# 原则：只跟踪「自己写的代码和文档」，运行时/缓存/用户数据一律不跟踪

# ---- 运行时（几百 MB，由 tools/setup-runtime.js 补齐，绝不入库）----
runtime/

# ---- 构建产物 ----
dist/
.build/

# ---- 用户数据 / 隐私（含 API Key，绝不入库）----
data/

# ---- 备份快照 ----
.backup/

# ---- 内部开发记录（内部文档，不对外公开）----
开发日志.md

# ---- 系统 / 编辑器和临时文件 ----
Thumbs.db
desktop.ini
*.tmp
*.log
.DS_Store

# ---- Node ----
node_modules/

# 例外：增强检索（ModSearch CLI）的两个依赖必须入库 ——
# tools/pack.js 的打包守卫要求 app/vendor/modsearch/node_modules/{undici,commander} 一定在场，
# 交给 npm 现装等于「换台机器/断网就编不出来」。上游 MIT，LICENSE 已随文件带上。
!app/vendor/modsearch/node_modules/
